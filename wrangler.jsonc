{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hearthline-api",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://ckforte.github.io,http://localhost:5173,http://127.0.0.1:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hearthline-data",
      "database_id": "174ce011-22a7-4785-91c5-d0931f62f619",
      "migrations_dir": "migrations"
    }
  ]
}
